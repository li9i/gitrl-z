<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APPLICATION_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-or-later</project_license>

  <name>gitrl-z</name>
  <summary>Visual reflog browser with reset preview</summary>

  <description>
    <p>
      The reflog records every position of every branch, including commits
      that a rebase rewrote or a reset abandoned. git shows this as a wall of
      text. gitrl-z draws it out the way gitg draws commit history.
    </p>
    <p>
      Click a reflog entry and the commit graph redraws with that branch
      moved to where a hard reset would put it. You see where the branch ends
      up and what gets left behind, before you touch anything.
    </p>
    <p>
      Nothing is ever written to the repository. gitrl-z shows you the command
      to run; running it stays your decision.
    </p>
  </description>

  <launchable type="desktop-id">@APPLICATION_ID@.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>The reflog lists what happened; the graph shows where a reset would land</caption>
      <image>https://raw.githubusercontent.com/li9i/gitrl-z/master/docs/screenshots/reflog-activity.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/li9i/gitrl-z</url>
  <url type="bugtracker">https://github.com/li9i/gitrl-z/issues</url>

  <developer id="io.github.li9i">
    <name>alexandros filotheou</name>
  </developer>

  <provides>
    <binary>gitrlz</binary>
  </provides>

  <categories>
    <category>Development</category>
    <category>RevisionControl</category>
  </categories>

  <keywords>
    <keyword>git</keyword>
    <keyword>reflog</keyword>
    <keyword>undo</keyword>
    <keyword>reset</keyword>
    <keyword>branches</keyword>
    <keyword>history</keyword>
    <keyword>preview</keyword>
  </keywords>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.8.0" date="2026-09-26">
      <description>
        <p>
          See what a rewind does to the files. In the rewind window, a double
          click on a branch that moves shows the commit it lands on, and the
          menu of the row also shows the diff of the whole move.
        </p>
        <p>
          The window opens on All branches. The stops on the dial follow the
          time between the moments, and the dial keeps its place while the
          repository changes.
        </p>
        <p>
          Copy the name of a branch from its pill in the reflog.
        </p>
      </description>
    </release>
    <release version="0.7.0" date="2026-08-14">
      <description>
        <p>
          Rewind the whole repository. All branches in the sidebar merges the
          reflogs of every local branch into the moments the repository has
          passed through, and a dial over the graph puts every branch back
          where it stood at the moment it rests on.
        </p>
        <p>
          List where each branch lands, and the commands that take you there,
          in a window of its own. A branch that did not exist at that moment is
          listed for removal.
        </p>
        <p>
          Copy the name of a branch, a tag or a remote ref from a right click
          in the sidebar or on a label in the graph.
        </p>
      </description>
    </release>
    <release version="0.6.0" date="2026-08-13">
      <description>
        <p>
          Draw the preview graph as the history the planned command leaves, so
          the commits it abandons drop out of the picture.
        </p>
        <p>
          Label each step of a rebase that carried several branches with the
          branch it moved, so the command offered for that step moves the right
          one.
        </p>
        <p>Open the diff of a commit on a double click in the graph.</p>
        <p>Say in the caption when the graph carries an extra commit.</p>
      </description>
    </release>
    <release version="0.5.0" date="2026-08-10">
      <description>
        <p>
          Open the diff of any commit in the reflog list or the graph from a
          right click, and copy its full hash from the same menu.
        </p>
        <p>
          Show that diff in gitg's own diff pane, with a section per changed
          file, numbered lines, syntax highlighting, and renderers for images
          and binary files.
        </p>
        <p>Redraw the application icon and put it on the window.</p>
      </description>
    </release>
    <release version="0.4.0" date="2026-08-06">
      <description>
        <p>Show the absolute timestamp when hovering over the date column.</p>
        <p>Reframe the project as a visual reflog browser with reset preview.</p>
      </description>
    </release>
    <release version="0.3.0" date="2026-08-04">
      <description>
        <p>
          Mark the reflog entry that was the newest one when the window opened,
          and keep the commit that HEAD was on at that moment in the graph.
        </p>
        <p>Keep a copied command on the clipboard after gitrl-z stops.</p>
      </description>
    </release>
    <release version="0.2.1" date="2026-07-26">
      <description>
        <p>
          Remove the libdazzle build dependency, which Ubuntu 26.04 does not
          have.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-07-26">
      <description>
        <p>Preview a detached HEAD, and recover from it.</p>
        <p>Show the git command that each reflog entry records.</p>
        <p>
          Give a warning while a git operation is in progress, and offer to
          abort it.
        </p>
        <p>
          Mark the branch that is checked out, and offer to make a deleted
          branch again.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-07-21">
      <description>
        <p>First release.</p>
      </description>
    </release>
  </releases>
</component>
