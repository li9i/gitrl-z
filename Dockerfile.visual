FROM gitrlz-build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        fonts-dejavu-core \
        gitg \
        python3-numpy \
        python3-pil \
    && rm -rf /var/lib/apt/lists/*

RUN test "$(dpkg-query -W -f='${Version}' gitg)" = "44-1build2" \
    || (echo "gitg version is not 44-1build2; the vendored source no longer matches" >&2; exit 1)

WORKDIR /src
CMD ["/bin/bash"]
